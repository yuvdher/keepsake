# Postgres (Neon). Added automatically when you connect Neon to the Vercel project.
DATABASE_URL=
# Photo storage (Vercel Blob). Added automatically when you connect a Blob store.
BLOB_READ_WRITE_TOKEN=
# Optional: your public address, used when building share links (no trailing slash).
NEXT_PUBLIC_SITE_URL=
# Optional: any random string, used to hash visitor IPs for rate limiting.
IP_SALT=
# Optional: protects the nightly cleanup job. Vercel sends it automatically if set.
CRON_SECRET=
